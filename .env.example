# Cyber Sentinel Environment Variables
# Copy this file to .env and fill in the values

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///database/cyber_sentinel.db

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Config file paths
CONFIG_PATH=config/config.yaml
POLICY_PATH=config/policy.yaml

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard settings
DASHBOARD_PORT=8501

# Model paths (optional overrides)
# ANOMALY_MODEL_PATH=models/anomaly/isolation_forest.joblib
# CLASSIFIER_MODEL_PATH=models/classifier/random_forest.joblib
